# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template. 실제 값이 아니라 **키 목록**이고, 이게 리포에
# 없으면 다음 사람이 무엇을 설정해야 하는지 알 길이 없다.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ── sauron-v2 ──────────────────────────────────────────────────────────────
# the copied backend's runtime artefacts
backend/.cache/
data/.cache/
backend.log
__pycache__/
*.pyc
.pytest_cache/

# vitest
/coverage

# impeccable 스킬의 런타임 스크래치(pid/port/token). 어제 세션이 남긴 것이
# `git add -A` 로 딸려 들어간 적이 있다 — 커밋에 들어갈 내용이 아니다.
# `.impeccable/critique/` 는 산출물이라 추적한다.
.impeccable/live/
