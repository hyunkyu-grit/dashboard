# sauron-v2 / rateslab — 프런트가 알아야 하는 값은 이것 하나다.
#
# 복사해서 쓰는 파일이고, 값이 들어 있지 않다. 어디에 무엇을 적는지는
# `README.md` 의 "배포" 절과 `src/lib/apiBase.ts` 의 머리글에 있다.
#
# ── NEXT_PUBLIC_API_BASE ────────────────────────────────────────────────────
# 백엔드(:8200 FastAPI)의 **출처**. `NEXT_PUBLIC_` 접두사가 있으므로 값이
# 빌드 시각에 브라우저 번들로 구워진다 — 비밀을 넣지 말 것.
#
#   로컬 개발      비워 두면 http://localhost:8200 으로 떨어진다(설정 불필요).
#                  다른 포트를 쓰면 `.env.development.local` 에 적는다.
#                  `.env.local` 에 적지 말 것 — `next build` 도 그 파일을 읽어
#                  개발용 주소가 프로덕션 번들에 실린다(guards/production-env).
#
#   Vercel         Tailscale Funnel 이 공개한 https 주소. 끝에 `/` 없이.
#                  예) https://<machine>.<tailnet>.ts.net
#
#   백엔드 없이 굽기  빈 문자열을 **명시**한다(아래 줄의 주석을 풀고 값 없이).
#                  같은 출처로만 나가고, 백엔드가 필요한 화면은
#                  "백엔드가 필요한 화면이에요" 패널이 된다.
#
# 프로덕션 빌드에서 이 값이 아예 없으면 빌드가 죽는다. 조용히 localhost 로
# 떨어지는 것이 v1 의 실제 사고였다.
NEXT_PUBLIC_API_BASE=

# ── 백엔드(:8200)가 읽는 값 ─────────────────────────────────────────────────
# 프런트 번들에는 들어가지 않는다. 백엔드를 띄우는 셸에서 export 한다.
#
# 허용 오리진. 콤마로 구분하고, 비워 두면 로컬 개발 오리진만 허용한다.
SAURON_ALLOWED_ORIGINS=
# 프리뷰 배포처럼 매번 주소가 바뀌는 경우의 정규식(전체 일치).
# 비워 두면 기본값(rateslab 프로젝트의 vercel.app 프리뷰)이 쓰인다.
SAURON_ALLOWED_ORIGIN_REGEX=
#
# MySQL 읽기 계정. **기본값이 없다** — 없으면 SQL 을 읽는 순간 죽는다.
BW_MYSQL_HOST=
BW_MYSQL_PORT=
BW_MYSQL_USER=
BW_MYSQL_PASSWORD=
BW_MYSQL_DB=
